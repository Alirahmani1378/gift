<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>برای تو</title>
<style>
  :root { --bg:#f5f3f0; --card:#fff; --ink:#111; --soft:#777; }
  @media (prefers-color-scheme: dark) {
    :root { --bg:#161616; --card:#1f1f1f; --ink:#f2f2f2; --soft:#aaa; }
  }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink); font-family: Tahoma, sans-serif;
    display:flex; justify-content:center; padding:20px 14px 130px; }
  .page { width:100%; max-width:480px; background:var(--card); border-radius:18px;
    padding:22px 20px; box-shadow:0 8px 30px rgba(0,0,0,.12); }
  h1 { font-size:24px; margin:4px 0 18px; text-align:center; }
  p { font-size:16px; line-height:2.1; margin:0 0 18px; white-space:pre-line; text-align:justify; }
  img { width:100%; border-radius:12px; display:block; margin:6px 0 20px; }
  .end { text-align:center; color:#b3121b; font-size:26px; margin-top:10px; }

  .player { position:fixed; left:0; right:0; bottom:0; direction:ltr; background:var(--card);
    box-shadow:0 -4px 20px rgba(0,0,0,.15); padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px)); }
  .pin { max-width:480px; margin:0 auto; display:flex; align-items:center; gap:12px; }
  #play { flex:0 0 48px; width:48px; height:48px; border-radius:50%; border:0; background:var(--ink);
    color:var(--card); font-size:18px; cursor:pointer; }
  .mid { flex:1; }
  .bar { width:100%; accent-color:var(--ink); margin:0; }
  .times { display:flex; justify-content:space-between; font-size:11px; color:var(--soft); }
</style>
</head>
<body>
<div class="page" id="page"></div>

<div class="player">
  <div class="pin">
    <button id="play" aria-label="play">▶</button>
    <div class="mid">
      <input class="bar" id="bar" type="range" min="0" max="100" value="0">
      <div class="times"><span id="cur">0:00</span><span id="dur">0:00</span></div>
    </div>
  </div>
  <audio id="audio" preload="metadata"></audio>
</div>

<script>
/* ===== فقط این قسمت رو برای هر نفر عوض کن ===== */
const NAME = "هاشم رحمانی";
const SONG = ").mp3";

/* هر خط یا یه عکسه یا یه متن. به ترتیب نمایش داده می‌شن.
   ["سلام", "..."]  = یه پاراگراف
   ["photo", "1.jpg"] = یه عکس                              */
const CONTENT = [
  ["text",  "پسلام."],
  ["photo", "IMG_.jpg"],
  ["text",  "پاراگراف دوم. بعد از عکس اول."],
  ["photo", "2.jpg"],
  ["photo", "3.jpg"],
  ["text",  "پاراگراف آخر. هر تعداد عکس و متن که خواستی خط اضافه کن."]
];
/* ============================================= */

document.title = NAME;
const page = document.getElementById("page");
const h1 = document.createElement("h1"); h1.textContent = NAME; page.append(h1);
CONTENT.forEach(([type, val]) => {
  if (type === "photo") {
    const im = document.createElement("img"); im.src = val; im.alt = ""; im.loading = "lazy"; page.append(im);
  } else {
    const p = document.createElement("p"); p.textContent = val; page.append(p);
  }
});
const end = document.createElement("div"); end.className = "end"; end.textContent = "♥"; page.append(end);

const a = document.getElementById("audio"), bar = document.getElementById("bar"),
      play = document.getElementById("play"), cur = document.getElementById("cur"),
      dur = document.getElementById("dur");
a.src = SONG;
const fmt = s => isFinite(s) ? Math.floor(s/60) + ":" + String(Math.floor(s%60)).padStart(2,"0") : "0:00";
play.onclick = () => a.paused ? a.play() : a.pause();
a.onplay  = () => play.textContent = "❚❚";
a.onpause = () => play.textContent = "▶";
a.onended = () => play.textContent = "▶";
a.onloadedmetadata = () => dur.textContent = fmt(a.duration);
a.ontimeupdate = () => { cur.textContent = fmt(a.currentTime);
  bar.value = a.duration ? (a.currentTime / a.duration) * 100 : 0; };
bar.oninput = () => { if (a.duration) a.currentTime = (bar.value / 100) * a.duration; };
</script>
</body>
</html>
